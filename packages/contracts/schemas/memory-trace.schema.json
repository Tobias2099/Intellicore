{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intellicore.local/schemas/memory-trace.schema.json",
  "title": "MemoryTraceRecord",
  "type": "object",
  "required": ["run_id", "cycle", "core_id", "address", "operation"],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "cycle": {
      "type": "integer",
      "minimum": 0
    },
    "core_id": {
      "type": "integer",
      "minimum": 0
    },
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]+$"
    },
    "operation": {
      "type": "string",
      "enum": ["load", "store", "prefetch", "evict", "hint"]
    },
    "cache_level": {
      "type": "string",
      "enum": ["l1i", "l1d", "l2", "llc"]
    },
    "prefetch_outcome": {
      "type": "string",
      "enum": ["useful", "late", "wasted"]
    }
  },
  "additionalProperties": false
}
