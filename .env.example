INTELLICORE_ENV=development

# Supabase cloud Postgres connection string.
# Use a server-side connection string, not a browser anon key.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

TELEMETRY_BATCH_SIZE=1000
GEM5_ROOT=/opt/gem5
INTELLICORE_ARTIFACT_ROOT=./artifacts
